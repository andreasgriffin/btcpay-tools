# Copy the BTCPay config template to ./config/btcpay_subscription.yaml and set
# BTCPAY_CONFIG_PATH to its mounted path. Keep API keys out of the image.
BTCPAY_CONFIG_PATH=/app/btcpay_subscription.yaml
BIND_HOST=0.0.0.0
PORT=8080
REQUEST_TIMEOUT_SECONDS=5
MAX_REQUEST_BYTES=4096
MAX_CONCURRENT_WORKFLOWS=8
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=10000
CREATE_RATE_LIMIT_REQUESTS=2
CREATE_RATE_LIMIT_WINDOW_SECONDS=3600
GLOBAL_CREATE_RATE_LIMIT_REQUESTS=10
GLOBAL_CREATE_RATE_LIMIT_WINDOW_SECONDS=3600
ACTIVATION_TIMEOUT_SECONDS=20
ACTIVATION_POLL_SECONDS=1
STATUS_RATE_LIMIT_REQUESTS=30
STATUS_RATE_LIMIT_WINDOW_SECONDS=60
# Plan catalog responses are cached in-process; 0 disables caching.
CATALOG_CACHE_TTL_SECONDS=300
# Set HOST_IP and HOST_PORT in the shell for Compose port publishing if needed.
# Compose defaults to 127.0.0.1:8080.
